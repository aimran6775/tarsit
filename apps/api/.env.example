# =====================================================
# Tarsit API - Environment Configuration
# =====================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Environment
NODE_ENV=development
PORT=4001

# API Base URL (used for Swagger docs, CORS in production)
API_BASE_URL=http://localhost:4001

# =====================================================
# Database (Supabase PostgreSQL)
# =====================================================
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# =====================================================
# Authentication
# =====================================================
# Generate strong secrets: openssl rand -base64 32
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# =====================================================
# Supabase (Auth, Storage, Realtime)
# =====================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# =====================================================
# OpenAI (for Tars AI Assistant)
# =====================================================
OPENAI_API_KEY=sk-your_openai_api_key_here

# =====================================================
# Caching (Redis - Upstash recommended for production)
# =====================================================
# Leave empty to use in-memory cache (dev only)
REDIS_URL=

# =====================================================
# Email (Resend - Recommended)
# =====================================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email (SMTP - Fallback if Resend not configured)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM="Tarsit <noreply@tarsit.com>"

# =====================================================
# Frontend URL (for CORS, email links)
# =====================================================
FRONTEND_URL=http://localhost:3001

# =====================================================
# Rate Limiting
# =====================================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

