{
  "version": 2,
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "pnpm prisma generate && pnpm build",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ],
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": true
  }
}
